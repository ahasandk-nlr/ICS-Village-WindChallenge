<?xml version="1.0"?>
<ot-sim>
  <message-bus>
    <pull-endpoint>tcp://127.0.0.1:9012</pull-endpoint>
    <pub-endpoint>tcp://127.0.0.1:3456</pub-endpoint>
  </message-bus>
  <cpu>
    <api-endpoint>0.0.0.0:9102</api-endpoint>
    <module name="backplane">ot-sim-message-bus {{config_file}}</module>
    <module name="gpio">ot-sim-rpi-gpio-module {{config_file}}</module>
    <module name="dnp3">ot-sim-dnp3-module {{config_file}}</module>
    <module name="logic">ot-sim-logic-module {{config_file}}</module>
  </cpu>
  <dnp3 name="dnp3-outstation" mode="server">
    <endpoint>0.0.0.0:20000</endpoint>
    <cold-restart-delay>15</cold-restart-delay>
    <outstation name="outstation-ied">
        <local-address>10</local-address>
        <remote-address>1</remote-address>
        <warm-restart-delay>5</warm-restart-delay>
        <input type="binary">
            <address>0</address>
            <tag>turbine.status</tag>
            <sgvar>Group1Var1</sgvar>
            <egvar>Group2Var1</egvar>
            <class>Class1</class>
        </input>
        <output type="binary">
            <address>10</address>
            <tag>turbine.control</tag>
            <sgvar>Group10Var2</sgvar>
            <egvar>Group11Var2</egvar>
            <class>Class1</class>
            <sbo>false</sbo>
        </output>
    </outstation>
  </dnp3>
  <logic>
    <period>1s</period>
    <process-updates>true</process-updates>
    <program>
      <![CDATA[
      # Fixed polarity - see docs/AUDIT.md and docs/PINOUT_MAP.md. This
      # used to be `notturbine = control==1 and estop==0` then
      # `turbine = not notturbine`, which meant the "turbine" GPIO pin
      # (and the DNP3-exposed "status" point, which mirrored the same
      # inverted value) both read LOW during normal operation and HIGH
      # after a successful attack - the opposite of bh-intellirupter's
      # and mitm-modbus's turbine outputs, and the opposite of what
      # "turbine.status" should mean to a real DNP3 master reading it.
      # Now: HIGH = running normally, LOW = stopped (attack succeeded),
      # matching every other turbine-relay channel in this repo.
      running = control == 1 and estop == 0
      status = running
      turbine = running
      # hack to get estop tag to show up in Telnet module
      estop = estop
      ]]>
    </program>
    <variables>
      <running>1</running>
      <turbine>1</turbine>
      <status tag="turbine.status">1</status>
      <control tag="turbine.control">1</control>
      <estop>0</estop>
    </variables>
  </logic>
  <rpi-gpio name="gpio" mode="board">
    <output pin="18">
      <tag>turbine</tag>
    </output>
  </rpi-gpio>
</ot-sim>
